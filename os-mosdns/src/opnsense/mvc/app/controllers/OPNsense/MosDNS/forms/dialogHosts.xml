<form>
    <field>
        <id>hosts.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this hosts entry</help>
        <grid_view>
            <sequence>1</sequence>
            <width>6em</width>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>hosts.name</id>
        <label>Name</label>
        <type>text</type>
        <help>Unique identifier for the hosts plugin</help>
        <grid_view>
            <sequence>2</sequence>
            <width>15em</width>
        </grid_view>
    </field>
    <field>
        <id>hosts.files</id>
        <label>Files</label>
        <type>text</type>
        <help>Host files configuration (e.g., file paths or host entries)</help>
        <grid_view>
            <sequence>3</sequence>
            <width>25em</width>
        </grid_view>
    </field>
</form>