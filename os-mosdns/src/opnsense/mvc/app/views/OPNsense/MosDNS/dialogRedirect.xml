<form>
    <field>
        <id>redirect.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this redirect configuration</help>
    </field>
    <field>
        <id>redirect.name</id>
        <label>Name</label>
        <type>text</type>
        <help>Name for this redirect configuration</help>
    </field>
    <field>
        <id>redirect.target</id>
        <label>Target</label>
        <type>text</type>
        <help>Target IP address for redirection (e.g., 127.0.0.1)</help>
    </field>
    <field>
        <id>redirect.description</id>
        <label>Description</label>
        <type>text</type>
        <help>Optional description for this redirect configuration</help>
    </field>
</form>