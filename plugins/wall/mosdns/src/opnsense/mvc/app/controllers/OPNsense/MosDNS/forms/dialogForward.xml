<form>
    <field>
        <id>forward.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this forward entry</help>
        <grid_view>
            <sequence>1</sequence>
            <width>6em</width>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>forward.name</id>
        <label>Tag</label>
        <type>text</type>
        <help>Unique tag identifier for the forward plugin</help>
        <grid_view>
            <sequence>2</sequence>
            <width>15em</width>
        </grid_view>
    </field>
    <field>
        <id>forward.concurrent</id>
        <label>Concurrent</label>
        <type>text</type>
        <help>Number of concurrent queries (1-10)</help>
        <grid_view>
            <sequence>3</sequence>
            <width>10em</width>
        </grid_view>
    </field>
    <field>
        <id>forward.upstream</id>
        <label>Upstream</label>
        <type>text</type>
        <help>Upstream DNS servers, one per line (e.g., udp://223.5.5.5)</help>
        <grid_view>
            <sequence>4</sequence>
            <width>20em</width>
        </grid_view>
    </field>
    <field>
        <id>forward.command</id>
        <label>Command</label>
        <type>text</type>
        <help>Additional command parameters for the forward plugin</help>
    </field>
</form>