<?xml version="1.0"?>
<form>
    <field>
        <id>rule.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this sequence rule</help>
    </field>
    <field>
        <id>rule.sequence</id>
        <label>Sequence</label>
        <type>dropdown</type>
        <help>Select the parent sequence for this rule</help>
    </field>
    <field>
        <id>rule.order</id>
        <label>Order</label>
        <type>text</type>
        <help>Execution order of this rule within the sequence</help>
    </field>
    <field>
        <id>rule.plugin</id>
        <label>Plugin</label>
        <type>text</type>
        <help>Plugin name to execute</help>
    </field>
    <field>
        <id>rule.tag</id>
        <label>Tag</label>
        <type>text</type>
        <help>Tag identifier for this rule</help>
    </field>
    <field>
        <id>rule.args</id>
        <label>Arguments</label>
        <type>text</type>
        <help>Arguments to pass to the plugin</help>
    </field>
    <field>
        <id>rule.description</id>
        <label>Description</label>
        <type>text</type>
        <help>Description of this rule</help>
    </field>
</form>