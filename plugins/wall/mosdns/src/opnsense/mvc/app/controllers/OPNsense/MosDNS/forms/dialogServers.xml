<form>
    <field>
        <id>servers.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this servers entry</help>
        <grid_view>
            <sequence>1</sequence>
            <width>6em</width>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>servers.name</id>
        <label>Name</label>
        <type>text</type>
        <help>Unique identifier for the servers plugin</help>
        <grid_view>
            <sequence>2</sequence>
            <width>15em</width>
        </grid_view>
    </field>
    <field>
        <id>servers.addr</id>
        <label>Address</label>
        <type>text</type>
        <help>Server address configuration (e.g., IP:port or domain:port)</help>
        <grid_view>
            <sequence>3</sequence>
            <width>20em</width>
        </grid_view>
    </field>
    <field>
        <id>servers.protocol</id>
        <label>Protocol</label>
        <type>text</type>
        <help>Protocol configuration (e.g., udp, tcp, tls, https)</help>
        <grid_view>
            <sequence>4</sequence>
            <width>10em</width>
        </grid_view>
    </field>
</form>