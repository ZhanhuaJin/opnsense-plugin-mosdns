<form>
    <field>
        <id>plugins.forward.forward.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this forward entry</help>
    </field>
    <field>
        <id>plugins.forward.forward.name</id>
        <label>Tag</label>
        <type>text</type>
        <help>Unique tag identifier for the forward plugin</help>
    </field>
    <field>
        <id>plugins.forward.forward.concurrent</id>
        <label>Concurrent</label>
        <type>text</type>
        <help>Number of concurrent queries (1-10)</help>
    </field>
    <field>
        <id>plugins.forward.forward.upstream</id>
        <label>Upstream</label>
        <type>textarea</type>
        <help>Upstream DNS servers, one per line (e.g., udp://223.5.5.5)</help>
    </field>
    <field>
        <id>plugins.forward.forward.command</id>
        <label>Command</label>
        <type>text</type>
        <help>Additional command parameters for the forward plugin</help>
    </field>
</form>