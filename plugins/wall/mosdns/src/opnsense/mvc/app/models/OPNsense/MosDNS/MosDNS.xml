<?xml version="1.0" encoding="utf-8"?>
<model>
    <mount>//OPNsense/MosDNS</mount>
    <description>MosDNS DNS Server Configuration</description>
    <version>1.0.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <config_file type="TextField">
                <default>/usr/local/etc/mosdns/config.yaml</default>
                <Required>N</Required>
            </config_file>
        </general>
        <plugins>
            <cache>
                <enabled type="BooleanField">
                    <default>0</default>
                    <Required>Y</Required>
                </enabled>
                <size type="IntegerField">
                    <default>1024</default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>65535</MaximumValue>
                    <Required>N</Required>
                </size>
                <lazy_cache_ttl type="IntegerField">
                    <default>86400</default>
                    <MinimumValue>1</MinimumValue>
                    <Required>N</Required>
                </lazy_cache_ttl>
            </cache>
            <fallback type="ArrayField">
                <fallback type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <primary type="TextField">
                        <default>8.8.8.8</default>
                        <Required>Y</Required>
                    </primary>
                    <secondary type="TextField">
                        <default>1.1.1.1</default>
                        <Required>N</Required>
                    </secondary>
                    <threshold type="IntegerField">
                        <default>500</default>
                        <MinimumValue>1</MinimumValue>
                        <MaximumValue>10000</MaximumValue>
                        <Required>N</Required>
                    </threshold>
                    <always_standby type="BooleanField">
                        <default>0</default>
                        <Required>N</Required>
                    </always_standby>
                    <description type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </description>
                </fallback>
            </fallback>
            <forward type="ArrayField">
                <forward type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <concurrent type="IntegerField">
                        <default>1</default>
                        <MinimumValue>1</MinimumValue>
                        <MaximumValue>10</MaximumValue>
                        <Required>N</Required>
                    </concurrent>
                    <upstreams type="ArrayField">
                        <upstream type="ArrayField">
                            <addr type="TextField">
                                <default></default>
                                <Required>Y</Required>
                                <ValidationMessage>Address is required</ValidationMessage>
                            </addr>
                            <trusted type="BooleanField">
                                <default>0</default>
                                <Required>N</Required>
                            </trusted>
                            <detour type="TextField">
                                <default></default>
                                <Required>N</Required>
                            </detour>
                            <bootstrap type="CSVListField">
                                <default></default>
                                <Required>N</Required>
                            </bootstrap>
                            <domain type="TextField">
                                <default></default>
                                <Required>N</Required>
                            </domain>
                            <enable_http3 type="BooleanField">
                                <default>0</default>
                                <Required>N</Required>
                            </enable_http3>
                        </upstream>
                    </upstreams>
                    <command type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </command>
                </forward>
            </forward>
            <hosts type="ArrayField">
                <hosts type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <hosts_file type="TextField">
                        <default>/etc/hosts</default>
                        <Required>Y</Required>
                    </hosts_file>
                    <description type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </description>
                </hosts>
            </hosts>
            <ipset type="ArrayField">
                <ipset type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <sets type="TextField">
                        <default></default>
                        <Required>Y</Required>
                    </sets>
                    <description type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </description>
                </ipset>
            </ipset>
            <redirect type="ArrayField">
                <redirect type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <target type="TextField">
                        <default>127.0.0.1</default>
                        <Required>Y</Required>
                    </target>
                    <description type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </description>
                </redirect>
            </redirect>
            <sequence type="ArrayField">
                <sequence type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <tag type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </tag>
                    <type type="OptionField">
                        <default>sequence</default>
                        <Required>Y</Required>
                        <OptionValues>
                            <sequence>Sequence</sequence>
                            <if>If</if>
                            <parallel>Parallel</parallel>
                        </OptionValues>
                    </type>
                    <args type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </args>
                    <description type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </description>
                    <rules type="ArrayField">
                        <rule type="ArrayField">
                            <enabled type="BooleanField">
                                <default>1</default>
                                <Required>Y</Required>
                            </enabled>
                            <name type="TextField">
                                <default></default>
                                <Required>Y</Required>
                                <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                                <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                            </name>
                            <tag type="TextField">
                                <default></default>
                                <Required>N</Required>
                            </tag>
                            <type type="OptionField">
                                <default>exec</default>
                                <Required>Y</Required>
                                <OptionValues>
                                    <exec>Exec</exec>
                                    <if>If</if>
                                    <matches>Matches</matches>
                                    <goto>Goto</goto>
                                    <return>Return</return>
                                </OptionValues>
                            </type>
                            <args type="TextField">
                                <default></default>
                                <Required>N</Required>
                            </args>
                            <description type="TextField">
                                <default></default>
                                <Required>N</Required>
                            </description>
                        </rule>
                    </rules>
                </sequence>
            </sequence>
            <servers type="ArrayField">
                <servers type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <entry type="TextField">
                        <default>main_sequence</default>
                        <Required>N</Required>
                    </entry>
                    <listen type="TextField">
                        <default>:53</default>
                        <Required>N</Required>
                    </listen>
                    <udp_or_tcp type="OptionField">
                        <default>udp</default>
                        <Required>Y</Required>
                        <OptionValues>
                            <udp>UDP</udp>
                            <tcp>TCP</tcp>
                            <both>Both</both>
                        </OptionValues>
                    </udp_or_tcp>
                    <description type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </description>
                </servers>
            </servers>
            <datasources type="ArrayField">
                <datasource type="ArrayField">
                    <enabled type="BooleanField">
                        <default>1</default>
                        <Required>Y</Required>
                    </enabled>
                    <name type="TextField">
                        <default></default>
                        <Required>Y</Required>
                        <mask>/^[a-zA-Z0-9_-]+$/u</mask>
                        <ValidationMessage>Name should only contain alphanumeric characters, underscores and dashes</ValidationMessage>
                    </name>
                    <url type="TextField">
                        <default></default>
                        <Required>Y</Required>
                    </url>
                    <backup_url type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </backup_url>
                    <update_interval type="IntegerField">
                        <default>86400</default>
                        <MinimumValue>3600</MinimumValue>
                        <MaximumValue>604800</MaximumValue>
                        <Required>N</Required>
                    </update_interval>
                    <description type="TextField">
                        <default></default>
                        <Required>N</Required>
                    </description>
                </datasource>
            </datasources>
        </plugins>

    </items>
</model>