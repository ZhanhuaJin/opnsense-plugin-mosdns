<form>
    <field>
        <id>fallback.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this fallback configuration</help>
    </field>
    <field>
        <id>fallback.name</id>
        <label>Name</label>
        <type>text</type>
        <help>Name for this fallback configuration</help>
    </field>
    <field>
        <id>fallback.primary</id>
        <label>Primary Server</label>
        <type>text</type>
        <help>Primary DNS server (e.g., 8.8.8.8)</help>
    </field>
    <field>
        <id>fallback.secondary</id>
        <label>Secondary Server</label>
        <type>text</type>
        <help>Secondary DNS server (e.g., 1.1.1.1)</help>
    </field>
    <field>
        <id>fallback.threshold</id>
        <label>Threshold</label>
        <type>text</type>
        <help>Response time threshold in milliseconds (1-10000)</help>
    </field>
    <field>
        <id>fallback.always_standby</id>
        <label>Always Standby</label>
        <type>checkbox</type>
        <help>Keep secondary server always on standby</help>
    </field>
    <field>
        <id>fallback.description</id>
        <label>Description</label>
        <type>text</type>
        <help>Optional description for this fallback configuration</help>
    </field>
</form>