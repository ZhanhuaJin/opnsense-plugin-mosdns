<?xml version="1.0" encoding="utf-8"?>
<dialog>
    <title>Sequence Rule</title>
    <description>Configure sequence rule</description>
    <fields>
        <enabled type="checkbox">
            <label>Enabled</label>
            <help>Enable this sequence rule</help>
        </enabled>
        <name type="text">
            <label>Name</label>
            <help>Unique name for this rule</help>
            <required>Y</required>
        </name>
        <tag type="text">
            <label>Tag</label>
            <help>Optional tag for this rule</help>
        </tag>
        <type type="dropdown">
            <label>Type</label>
            <help>Rule type</help>
            <required>Y</required>
            <options>
                <exec>Exec</exec>
                <if>If</if>
                <matches>Matches</matches>
                <goto>Goto</goto>
                <return>Return</return>
            </options>
        </type>
        <args type="text">
            <label>Arguments</label>
            <help>Arguments for this rule</help>
        </args>
        <description type="text">
            <label>Description</label>
            <help>Optional description for this rule</help>
        </description>
    </fields>
</dialog>